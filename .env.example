# =============================================================================
# HEALTHCARE Platform — Environment Configuration Template
# Copy this file to .env.local for local frontend development
# =============================================================================

# Base URL for the AWS API Gateway HTTP API (leave empty for standalone offline demo)
VITE_API_BASE_URL=

# AWS Region where Cognito and API Gateway are deployed
VITE_AWS_REGION=ap-south-1

# Amazon Cognito User Pool ID
VITE_COGNITO_USER_POOL_ID=

# Amazon Cognito App Client ID
VITE_COGNITO_CLIENT_ID=

# Map Tile Provider (e.g. openstreetmap)
VITE_MAP_PROVIDER=openstreetmap
